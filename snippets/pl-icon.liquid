{%- comment -%}
  Renders one of Purelane's line icons.
  Usage: {% render 'pl-icon', icon: 'leaf', class: 'bi' %}
  All icons are decorative by default (aria-hidden="true") because in
  every usage in this theme the meaning is already carried by adjacent
  text. If an icon is ever used with no adjacent text, pass label:'...'
  to get an accessible name instead.
{%- endcomment -%}
{%- liquid
  assign cls = class | default: ''
  assign label = label | default: ''
-%}
{%- case icon -%}

  {%- when 'leaf' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" {% if label != '' %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}>
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    </svg>

  {%- when 'shield-check' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" {% if label != '' %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}>
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
      <path d="m9 12 2.2 2.2L15.4 10"/>
    </svg>

  {%- when 'no-chem', 'no-chemical' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" {% if label != '' %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}>
      <circle cx="12" cy="12" r="8.4"/>
      <path d="M6.4 17.6 17.6 6.4"/>
    </svg>

  {%- when 'paw' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" {% if label != '' %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %}>
      <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h13m-5-6 6 6-6 6"/>
    </svg>

  {%- when 'check' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 13 4 4L19 7"/>
    </svg>

  {%- when 'star' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="m12 2.6 2.9 6.1 6.7.8-4.9 4.6 1.2 6.7L12 17.5l-6 3.3 1.2-6.7-4.9-4.6 6.7-.8Z"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m6 9 6 6 6-6"/>
    </svg>

{%- endcase -%}
