{%- comment -%}
  Accepts: rating (number, 0-5, can be decimal)
  Renders 5 stars, visually filled up to `rating`, with a proper
  text alternative for screen readers (the prototype used decorative
  ★ characters with no accessible label at all).
{%- endcomment -%}
{%- assign full_stars = rating | at_most: 5 | at_least: 0 -%}
<span class="pl-stars" role="img" aria-label="Rated {{ rating }} out of 5 stars">
  {%- for i in (1..5) -%}
    {%- if i <= full_stars -%}
      {%- render 'pl-icon', icon: 'star' -%}
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.4 6.9.7-5.2 4.7 1.5 6.9L12 17.6l-6.1 3.6 1.5-6.9-5.2-4.7 6.9-.7Z"/></svg>
    {%- endif -%}
  {%- endfor -%}
</span>
