{{ 'purelane-full-range.css' | asset_url | stylesheet_tag }}

<section
  id="range-{{ section.id }}"
  class="pl-range-section"
  data-section-id="{{ section.id }}"
>
  <div class="pl-range-wrap">

    <div class="pl-range-panel">

      <div class="pl-range-head">

        <div class="pl-range-heading">
          {% if section.settings.kicker != blank %}
            <span class="pl-kicker">
              {{ section.settings.kicker }}
            </span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="pl-range-title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>

        {% if section.settings.description != blank %}
          <p class="pl-range-description">
            {{ section.settings.description }}
          </p>
        {% endif %}

      </div>


      {% if section.blocks.size > 0 %}

        <div class="pl-range-strip-wrap">

          <div
            class="pl-range-row"
            role="list"
            aria-label="{{ section.settings.heading | escape }}"
          >

            {% for block in section.blocks %}

              <div
                class="pl-range-product"
                role="listitem"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="pl-range-product-link"
                    aria-label="{{ block.settings.alt | default: block.settings.title | escape }}"
                  >
                {% endif %}

                {% if block.settings.image != blank %}

                  {{
                    block.settings.image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '180, 250, 350, 500',
                      sizes: '(max-width: 760px) 120px, 150px',
                      class: 'pl-range-product-image',
                      alt: block.settings.alt | default: block.settings.title
                  }}

                {% else %}

                  <div class="pl-range-placeholder">
                    <span>Product image</span>
                  </div>

                {% endif %}

                {% if block.settings.title != blank %}
                  <span class="pl-range-product-title">
                    {{ block.settings.title }}
                  </span>
                {% endif %}

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}

              </div>

            {% endfor %}

          </div>

        </div>

        <p class="pl-range-hint">
          {{ section.settings.swipe_text }}
        </p>

      {% endif %}

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-full-range",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "text",
      "id": "swipe_text",
      "label": "Mobile swipe text",
      "default": "Swipe to see the full shelf"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product name",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Purelane Full Range",
      "blocks": [
        {
          "type": "product",
          "settings": {
