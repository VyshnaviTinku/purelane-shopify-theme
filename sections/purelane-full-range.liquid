{{ 'purelane-full-range.css' | asset_url | stylesheet_tag }}

<section
  id="range-{{ section.id }}"
  class="pl-range-section"
  data-section-id="{{ section.id }}"
>

  <div class="pl-range-wrap">

    <div class="pl-range-panel">

      <!-- ================= HEADER ================= -->

      <div class="pl-range-head">

        <div class="pl-range-heading">

          {% if section.settings.kicker != blank %}
            <span class="pl-range-kicker">
              {{ section.settings.kicker }}
            </span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="pl-range-title">
              {{ section.settings.heading }}
            </h2>
          {% endif %}

        </div>


        {% if section.settings.description != blank %}
          <p class="pl-range-description">
            {{ section.settings.description }}
          </p>
        {% endif %}

      </div>


      <!-- ================= PRODUCT SHELF ================= -->

      <div class="pl-range-strip-wrap">

        <div
          class="pl-range-row"
          role="list"
          aria-label="{{ section.settings.heading | escape }}"
        >

          <!-- FLOOR -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-floor"
              role="img"
              aria-label="Purelane natural herbal floor cleaner"
            ></span>
          </div>


          <!-- TAP -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-tap"
              role="img"
              aria-label="Purelane tap cleaner and limescale remover"
            ></span>
          </div>


          <!-- KITCHEN -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-kitchen"
              role="img"
              aria-label="Purelane foaming kitchen cleaner"
            ></span>
          </div>


          <!-- TOILET -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-toilet"
              role="img"
              aria-label="Purelane non-toxic toilet cleaner"
            ></span>
          </div>


          <!-- LAUNDRY -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-laundry"
              role="img"
              aria-label="Purelane natural laundry detergent"
            ></span>
          </div>


          <!-- DISHWASH -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-dish"
              role="img"
              aria-label="Purelane organic dishwash liquid gel"
            ></span>
          </div>


          <!-- METAL -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-metal"
              role="img"
              aria-label="Purelane copper bronze and brass cleaner"
            ></span>
          </div>


          <!-- WASHING MACHINE -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-wm"
              role="img"
              aria-label="Purelane washing machine cleaner and descaler"
            ></span>
          </div>


          <!-- HANDWASH -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-handwash"
              role="img"
              aria-label="Purelane gentle hydrating liquid handwash"
            ></span>
          </div>


          <!-- MAGIC ERASER -->
          <div class="pl-range-product" role="listitem">
            <span
              class="pl-range-bottle pl-eraser"
              role="img"
              aria-label="Purelane magic eraser"
            ></span>
          </div>


          <!-- ORANGE END BLOCK -->
          <div
            class="pl-range-end-card"
            role="img"
            aria-label="More Purelane products"
          >
            <span></span>
            <span></span>
          </div>

        </div>

      </div>


      <!-- ================= MOBILE HINT ================= -->

      {% if section.settings.swipe_text != blank %}
        <p class="pl-range-hint">
          {{ section.settings.swipe_text }}
        </p>
      {% endif %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Purelane Full Range",
  "tag": "section",
  "class": "purelane-full-range",

  "settings": [

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },

    {
      "type": "text",
      "id": "swipe_text",
      "label": "Mobile swipe text",
      "default": "Swipe to see the full shelf"
    }

  ],

  "presets": [
    {
      "name": "Purelane Full Range"
    }
  ]
}
{% endschema %}