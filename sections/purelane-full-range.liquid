            "title": "Tap & limescale"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Kitchen cleaner"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Toilet cleaner"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Laundry detergent"
          }
        },
        {
