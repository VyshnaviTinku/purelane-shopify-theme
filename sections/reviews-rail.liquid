{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-reviews-rail.css' | asset_url | stylesheet_tag }}

<section class="pl-reviews color-{{ section.settings.color_scheme }}" id="reviews" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-revhead pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.rating_value != blank -%}
        <span class="pl-agg">
          {%- render 'pl-stars', rating: section.settings.rating_value -%}
          <b>{{ section.settings.rating_value }}</b> from {{ section.settings.rating_count_label }}
        </span>
      {%- endif -%}
      {%- if section.settings.homes_label != blank -%}
        <span class="pl-agg">{{ section.settings.homes_label }}</span>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="pl-revrail pl-rv" data-reviews-rail>
      {%- comment -%}
        The card list is rendered twice back-to-back so the CSS marquee
        can loop seamlessly at translateX(-50%). The second copy is
        hidden from assistive tech (aria-hidden) so screen reader users
        hear each testimonial once, not twice — the prototype rendered
        both copies with no such guard.
      {%- endcomment -%}
      <div class="pl-revtrack" data-reviews-track style="--pl-marq-duration:{{ section.settings.speed }}s">
        {%- for pass in (1..2) -%}
          <div class="pl-revtrack__set" {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <article class="pl-glass-2 pl-rcard" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.rating -%}
                  {%- render 'pl-stars', rating: block.settings.rating -%}
                {%- endif -%}
                <h5>{{ block.settings.title }}</h5>
                <p>{{ block.settings.quote }}</p>
                <div class="pl-rcard__who">
                  {%- render 'pl-icon', icon: 'check' -%}
                  <b>{{ block.settings.author }}</b>
                  {%- if block.settings.context != blank -%}<span>· {{ block.settings.context }}</span>{%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'section-reviews-rail.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Reviews rail",
  "tag": "section",
  "class": "section-reviews-rail",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating_value", "label": "Aggregate rating (0–5)", "default": "4.8" },
    { "type": "text", "id": "rating_count_label", "label": "Rating count label", "default": "8,000+ reviews" },
    { "type": "text", "id": "homes_label", "label": "Secondary stat", "default": "Loved by 12 lakh+ homes" },
    {
      "type": "range", "id": "speed", "label": "Scroll speed", "min": 20, "max": 80, "step": 5, "unit": "s", "default": 50,
      "info": "Seconds for one full loop. Lower is faster."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "default": 5 },
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author", "default": "Verified buyer" },
        { "type": "text", "id": "context", "label": "Context", "info": "e.g. product or category name", "default": "Laundry detergent" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Reviews rail",
      "blocks": [
        { "type": "review" }, { "type": "review" }, { "type": "review" },
        { "type": "review" }, { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
