{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-bundles.css' | asset_url | stylesheet_tag }}

<section class="pl-bundles color-{{ section.settings.color_scheme }}" id="bundles" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-bundles__intro pl-rv" style="margin-bottom:16px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p class="pl-lede" style="margin:0 auto">{{ section.settings.subtext }}</p>{%- endif -%}
      </div>
    </div>

    <div class="pl-tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign bullets = block.settings.bullets | newline_to_br | split: '<br />'
        -%}
        <article class="pl-glass pl-tier{% if block.settings.featured %} pl-tier--best{% endif %} pl-rv pl-rv-d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="pl-tier__tag">{{ block.settings.tag }}</span>

          <div class="pl-tierpix{% if block.settings.quantity >= 5 %} pl-tierpix--five{% endif %}" aria-hidden="true">
            {%- for img in (1..5) -%}
              {%- assign img_setting = 'image_' | append: img -%}
              {%- assign tier_img = block.settings[img_setting] -%}
              {%- if tier_img -%}
                <img src="{{ tier_img | image_url: width: 140 }}" width="70" height="{{ tier_img.height | times: 70 | divided_by: tier_img.width }}" alt="" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="pl-tier__qty">{{ block.settings.quantity }}<small>Products</small></div>

          {%- if p != blank -%}
            <div class="pl-tier__price">
              {{ p.price | money }}
              {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {%- if block.settings.quantity > 0 -%}
              {%- comment -%} multiply by 1.0 BEFORE dividing so this is float division, not truncating integer division. {%- endcomment -%}
              <p class="pl-tier__per body-s">Flat {{ p.price | times: 1.0 | divided_by: block.settings.quantity | money }} per product</p>
            {%- endif -%}
          {%- else -%}
            <p class="pl-tier__per body-s">Select a product in the section settings to show a live price.</p>
          {%- endif -%}

          {%- if bullets.size > 0 -%}
            <ul class="pl-tier__list">
              {%- for bullet in bullets -%}
                {%- if bullet != blank -%}
                  <li>{%- render 'pl-icon', icon: 'check' -%}{{ bullet }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <a class="pl-btn {% if block.settings.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %} pl-tier__cta"
             href="{{ block.settings.cta_link | default: p.url | default: '#' }}">
            {{ block.settings.cta_label | default: 'Build this box' }}
            {%- if block.settings.featured -%}{%- render 'pl-icon', icon: 'arrow-right' -%}{%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section-bundles",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subtext", "label": "Supporting text", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "range", "id": "quantity", "label": "Products in this tier", "min": 1, "max": 8, "default": 2 },
        { "type": "product", "id": "product", "label": "Product for live price", "info": "Price, compare-at price, and the button link (if no custom link is set) all come from this product." },
        { "type": "image_picker", "id": "image_1", "label": "Preview thumbnail 1" },
        { "type": "image_picker", "id": "image_2", "label": "Preview thumbnail 2" },
        { "type": "image_picker", "id": "image_3", "label": "Preview thumbnail 3" },
        { "type": "image_picker", "id": "image_4", "label": "Preview thumbnail 4" },
        { "type": "image_picker", "id": "image_5", "label": "Preview thumbnail 5" },
        { "type": "textarea", "id": "bullets", "label": "Feature list", "info": "One per line.", "default": "Free shipping across India" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as most popular", "default": false },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "cta_link", "label": "Button link (defaults to product page)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "quantity": 2 } },
        { "type": "tier", "settings": { "tag": "Most popular", "quantity": 3, "featured": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "quantity": 5 } }
      ]
    }
  ]
}
{% endschema %}
