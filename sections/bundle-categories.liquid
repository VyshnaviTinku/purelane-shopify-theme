{{ 'bundle-categories.css' | asset_url | stylesheet_tag }}

<section
  id="bundle-categories-{{ section.id }}"
  class="pl-bundle-section"
>

  <div class="pl-bundle-wrap">

    <!-- ================= BUNDLE CATEGORIES ================= -->

    <div class="pl-bundle-head">

      {% if section.settings.kicker != blank %}
        <span class="pl-kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pl-bundle-title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

    </div>


    <div class="pl-bundle-grid">


      <!-- KITCHEN -->
      <a
        href="{{ section.settings.kitchen_link | default: '#combos' }}"
        class="pl-bundle-card"
      >

        <div class="pl-bundle-image">

          <span
            class="pl-bottle pl-kitchen"
            role="img"
            aria-label="Purelane foaming kitchen cleaner"
          ></span>

        </div>

        <div class="pl-bundle-content">

          <h3 class="pl-bundle-card-title">
            Kitchen bundle
          </h3>

          <p class="pl-bundle-card-description">
            Grease, dishes &amp; more
          </p>

        </div>

      </a>


      <!-- BATHROOM -->
      <a
        href="{{ section.settings.bathroom_link | default: '#combos' }}"
        class="pl-bundle-card"
      >

        <div class="pl-bundle-image">

          <span
            class="pl-bottle pl-toilet"
            role="img"
            aria-label="Purelane non-toxic toilet cleaner"
          ></span>

        </div>

        <div class="pl-bundle-content">

          <h3 class="pl-bundle-card-title">
            Bathroom bundle
          </h3>

          <p class="pl-bundle-card-description">
            Deep clean &amp; disinfect
          </p>

        </div>

      </a>


      <!-- LAUNDRY -->
      <a
        href="{{ section.settings.laundry_link | default: '#combos' }}"
        class="pl-bundle-card"
      >

        <div class="pl-bundle-image">

          <span
            class="pl-bottle pl-laundry"
            role="img"
            aria-label="Purelane non-toxic laundry detergent"
          ></span>

        </div>

        <div class="pl-bundle-content">

          <h3 class="pl-bundle-card-title">
            Laundry bundle
          </h3>

          <p class="pl-bundle-card-description">
            Softer, fresher wash
          </p>

        </div>

      </a>


      <!-- HARD WATER -->
      <a
        href="{{ section.settings.hard_water_link | default: '#combos' }}"
        class="pl-bundle-card"
      >

        <div class="pl-bundle-image">

          <span
            class="pl-bottle pl-laundry"
            role="img"
            aria-label="Purelane tap cleaner and limescale remover"
          ></span>

        </div>

        <div class="pl-bundle-content">

          <h3 class="pl-bundle-card-title">
            Hard water bundle
          </h3>

          <p class="pl-bundle-card-description">
            Melt away limescale
          </p>

        </div>

      </a>

    </div>



    <!-- ================= TRUST BAR ================= -->

    <div class="pl-trust-bar">


      <!-- PLANT DERIVED -->
      <div class="pl-trust-item">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <span>
          Plant derived<br>
          formulas
        </span>

      </div>


      <!-- RECYCLABLE -->
      <div class="pl-trust-item">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/>
          <path d="M4 8 6.5 3h11L20 8M9.5 12h5"/>
        </svg>

        <span>
          Recyclable<br>
          packaging
        </span>

      </div>


      <!-- SAFE FOR KIDS & PETS -->
      <div class="pl-trust-item">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/>
        </svg>

        <span>
          Safe for<br>
          kids &amp; pets
        </span>

      </div>


      <!-- MADE IN INDIA -->
      <div class="pl-trust-item">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="8.6"/>
          <path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/>
        </svg>

        <span>
          Made in<br>
          India
        </span>

      </div>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Bundle Categories",
  "tag": "section",
  "class": "purelane-bundle-categories",

  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],

  "blocks": [
    {
      "type": "product",
      "name": "Bundle category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Bundle link"
        }
      ]
    }
  ],

  "max_blocks": 4,

  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "Kitchen bundle",
            "description": "Grease, dishes & more"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Bathroom bundle",
            "description": "Deep clean & disinfect"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Laundry bundle",
            "description": "Softer, fresher wash"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Hard water bundle",
            "description": "Melt away limescale"
          }
        }
      ]
    }
  ]
}
{% endschema %}