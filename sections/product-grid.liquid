{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-shop-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.product_count
  assign badge_tags = 'best-seller:Best seller,new:New,top-rated:Top rated'
-%}

<section class="pl-shop color-{{ section.settings.color_scheme }}" id="shop" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>{%- render 'pl-icon', icon: 'leaf' -%}<i></i></div>
    </div>

    {%- if coll != blank -%}
     <div class="pl-shelf">
  {%- for product in coll.products limit: limit -%}
    {%- assign card_index = forloop.index0 | modulo: 4 -%}
    {%- render 'pl-product-card', product: product, card_badge_tags: badge_tags, card_index: card_index -%}
  {%- else -%}
    <p class="pl-lede">No products in this collection yet.</p>
  {%- endfor -%}
</div>

      {%- if coll.products.size > limit -%}
        <div class="pl-shop__more">
          <a class="pl-btn pl-btn-ghost" href="{{ coll.url }}">View all {{ coll.products.size }} products {%- render 'pl-icon', icon: 'arrow-right' -%}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="pl-lede">Select a collection in the section settings to show products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Shop grid" }]
}
{% endschema %}
