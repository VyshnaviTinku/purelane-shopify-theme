{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-combos.css' | asset_url | stylesheet_tag }}

<section class="pl-combos color-{{ section.settings.color_scheme }}" id="combos" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule"><i></i>{%- render 'pl-icon', icon: 'leaf' -%}<i></i></div>
      {%- if section.settings.subtext != blank -%}<p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subtext }}</p>{%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="pl-comborail pl-rv" role="list" tabindex="0" aria-label="Best-selling combos, scroll to browse">
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign save_amount = p.compare_at_price | minus: p.price
          -%}
          <article class="pl-glass pl-combo{% if block.settings.featured %} pl-combo--hero{% endif %}" role="listitem" {{ block.shopify_attributes }}>
            <div class="pl-combo__tray">
              {%- if save_amount > 0 -%}
                <span class="pl-combo__save">You save {{ save_amount | money }}</span>
              {%- elsif block.settings.save_label != blank -%}
                <span class="pl-combo__save">{{ block.settings.save_label }}</span>
              {%- endif -%}
              {%- if block.settings.flag != blank -%}
                <span class="pl-combo__flag">{{ block.settings.flag }}</span>
              {%- endif -%}

              <div class="pl-stack">
                {%- for i in (1..3) -%}
                  {%- assign product_key = 'item_' | append: i | append: '_product' -%}
                  {%- assign caption_key = 'item_' | append: i | append: '_caption' -%}
                  {%- assign item_product = block.settings[product_key] -%}
                  {%- assign item_caption = block.settings[caption_key] -%}
                  {%- if item_product != blank or item_caption != blank -%}
                    {%- if i > 1 -%}<span class="pl-stack__plus" aria-hidden="true">+</span>{%- endif -%}
                    <span class="pl-stack__it">
                      {%- if item_product.featured_media -%}
                        {{ item_product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: item_product.title, class: 'pl-stack__img' }}
                      {%- else -%}
                        <span class="pl-stack__tile" aria-hidden="true">{%- render 'pl-icon', icon: 'leaf' -%}</span>
                      {%- endif -%}
                      <span>{{ item_caption }}</span>
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

            <div class="pl-combo__body">
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.product_count_label != blank -%}
                <div class="pl-combo__cnt">{{ block.settings.product_count_label }}</div>
              {%- endif -%}
              {%- if block.settings.includes != blank -%}
                <p class="pl-combo__inc">{{ block.settings.includes }}</p>
              {%- endif -%}

              {%- if p != blank -%}
                <div class="pl-combo__prow">
                  <strong>{{ p.price | money }}</strong>
                  {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
                  {%- if save_amount > 0 -%}<em>Save {{ save_amount | money }}</em>{%- endif -%}
                </div>
              {%- endif -%}
              <div class="pl-combo__fine">Inclusive of all taxes · COD available</div>

              <a class="pl-btn {% if block.settings.featured %}pl-btn-primary{% else %}pl-btn-ghost{% endif %}"
                 href="{{ block.settings.cta_link | default: p.url | default: '#' }}">
                Shop bundle {%- render 'pl-icon', icon: 'arrow-right' -%}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="pl-swipecue" aria-hidden="true">{%- render 'pl-icon', icon: 'arrow-right' -%}Swipe for more combos</div>
      {%- if section.settings.footnote != blank -%}
        <p class="pl-railnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "section-combos",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subtext", "label": "Supporting text", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "product", "id": "product", "label": "Combo product", "info": "Price, compare-at price and checkout link come from this product — set it up as a real product in your catalog with the combo's discounted price." },
        { "type": "text", "id": "product_count_label", "label": "Product count label", "default": "3 products" },
        { "type": "textarea", "id": "includes", "label": "Includes copy" },
        { "type": "text", "id": "save_label", "label": "Save badge override", "info": "Only used if the combo product has no compare-at price set." },
        { "type": "text", "id": "flag", "label": "Flag (optional)", "info": "e.g. \"Most popular\"" },
        { "type": "checkbox", "id": "featured", "label": "Highlight as hero combo", "default": false },
        { "type": "url", "id": "cta_link", "label": "Button link (defaults to product page)" },
        { "type": "header", "content": "Preview items (up to 3)" },
        { "type": "product", "id": "item_1_product", "label": "Item 1 product" },
        { "type": "text", "id": "item_1_caption", "label": "Item 1 caption" },
        { "type": "product", "id": "item_2_product", "label": "Item 2 product" },
        { "type": "text", "id": "item_2_caption", "label": "Item 2 caption" },
        { "type": "product", "id": "item_3_product", "label": "Item 3 product" },
        { "type": "text", "id": "item_3_caption", "label": "Item 3 caption" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Best-selling combos",
      "blocks": [{ "type": "combo" }, { "type": "combo" }, { "type": "combo" }]
    }
  ]
}
{% endschema %}
