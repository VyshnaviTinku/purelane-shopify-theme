{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-ingredients.css' | asset_url | stylesheet_tag }}

<section class="pl-ingredients color-{{ section.settings.color_scheme }}" id="ingredients" data-scene="2" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-panel-head pl-rv" style="padding:34px 18px">
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        {%- render 'pl-icon', icon: 'leaf' -%}
        <i></i>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="pl-ing">
          {%- for block in section.blocks -%}
            <div class="pl-ing__i" {{ block.shopify_attributes }}>
              <div class="pl-ing__art">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 168 | image_tag: loading: 'lazy', alt: block.settings.title }}
                {%- else -%}
                  {%- render 'pl-icon', icon: 'leaf' -%}
                {%- endif -%}
              </div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "section-ingredients",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon/illustration", "info": "Falls back to a generic leaf icon if left blank." },
        { "type": "text", "id": "title", "label": "Name", "default": "Coconut" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Plant-derived cleansers that lift grease" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Coconut", "description": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "title": "Orange peel", "description": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "title": "Soap nut", "description": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "title": "Neem", "description": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "title": "Lemongrass", "description": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
